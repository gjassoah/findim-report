  [inst_1 : CategoryTheory.Abelian C] [inst_2 : CategoryTheory.HasExt C] {X Y : C}
  (R : CategoryTheory.ProjectiveResolution X) (n : ℕ),
  Subsingleton (CategoryTheory.Abelian.Ext X Y (n + 1)) ↔
    ∀ (f : R.complex.X (n + 1) ⟶ Y),
      CategoryTheory.CategoryStruct.comp (R.complex.d (n + 2) (n + 1)) f = 0 →
        ∃ g, CategoryTheory.CategoryStruct.comp (R.complex.d (n + 1) n) g = f
@ResolutionExt.ext_vanishing_iff : ∀ {C : Type u_3} [inst : CategoryTheory.Category.{u_2, u_3} C]
  [inst_1 : CategoryTheory.Abelian C] [inst_2 : CategoryTheory.HasExt C] {X Y : C}
  (R : CategoryTheory.ProjectiveResolution X),
  (∀ (n : ℕ), Subsingleton (CategoryTheory.Abelian.Ext X Y n)) ↔
    (Function.Injective fun f => CategoryTheory.CategoryStruct.comp (R.complex.d 1 0) f) ∧
      ∀ (n : ℕ) (f : R.complex.X (n + 1) ⟶ Y),
        CategoryTheory.CategoryStruct.comp (R.complex.d (n + 2) (n + 1)) f = 0 →
          ∃ g, CategoryTheory.CategoryStruct.comp (R.complex.d (n + 1) n) g = f
