  (R : CategoryTheory.ProjectiveResolution X) (n : ℕ),
  Subsingleton (CategoryTheory.Abelian.Ext X Y (n + 1)) ↔
    ∀ (f : R.complex.X (n + 1) ⟶ Y),
      CategoryTheory.CategoryStruct.comp (R.complex.d (n + 2) (n + 1)) f = 0 →
        ∃ g, CategoryTheory.CategoryStruct.comp (R.complex.d (n + 1) n) g = f
