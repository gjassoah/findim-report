@RingDual.freeDualEquiv : {A : Type u_1} →
  [inst : Ring A] → (ι : Type u_2) → [Fintype ι] → [DecidableEq ι] → RingDual.RightDual A (ι → Aᵐᵒᵖ) ≃ₗ[A] ι → A
@RingDual.evalEquiv : {A : Type u_1} →
  [inst : Ring A] →
    {P : Type u_2} →
      [inst_1 : AddCommGroup P] →
        [inst_2 : Module Aᵐᵒᵖ P] →
          [Module.Finite Aᵐᵒᵖ P] → [Module.Projective Aᵐᵒᵖ P] → P ≃ₗ[Aᵐᵒᵖ] RingDual.LeftDual A (RingDual.RightDual A P)
@RingDual.rightDual_projective : ∀ {A : Type u_1} [inst : Ring A] {P : Type u_2} [inst_1 : AddCommGroup P]
  [inst_2 : Module Aᵐᵒᵖ P] [Module.Finite Aᵐᵒᵖ P] [Module.Projective Aᵐᵒᵖ P],
  Module.Projective A (RingDual.RightDual A P)
@RingDual.rightDual_finite : ∀ {A : Type u_1} [inst : Ring A] {P : Type u_2} [inst_1 : AddCommGroup P]
  [inst_2 : Module Aᵐᵒᵖ P] [Module.Finite Aᵐᵒᵖ P] [Module.Projective Aᵐᵒᵖ P], Module.Finite A (RingDual.RightDual A P)
@RingDual.split_of_dual_split : ∀ {A : Type u_1} [inst : Ring A] {P : Type u_2} {P' : Type u_3}
  [inst_1 : AddCommGroup P] [inst_2 : AddCommGroup P'] [inst_3 : Module Aᵐᵒᵖ P] [inst_4 : Module Aᵐᵒᵖ P']
  [Module.Finite Aᵐᵒᵖ P] [Module.Projective Aᵐᵒᵖ P] [Module.Finite Aᵐᵒᵖ P'] [Module.Projective Aᵐᵒᵖ P']
  (f : P →ₗ[Aᵐᵒᵖ] P') (r : RingDual.RightDual A P →ₗ[A] RingDual.RightDual A P'),
  r ∘ₗ RingDual.rightMap f = LinearMap.id → ∃ s, f ∘ₗ s = LinearMap.id
@ExactCoresolution.coresolution : {A : Type u_1} →
  [inst : Ring A] →
    (X : ℕ → ModuleCat A) →
      (d : (n : ℕ) → ↑(X n) →ₗ[A] ↑(X (n + 1))) →
        (∀ (n : ℕ), (d n).range = (d (n + 1)).ker) →
          Function.Injective ⇑(d 0) →
            (∀ (n : ℕ), CategoryTheory.Projective (X (n + 1))) → ProjectiveCoresolution (ModuleCat A)
@StrongNakayama.coresolution : {A : Type u_1} →
  [inst : Ring A] →
    (P : ℕ → ModuleCat Aᵐᵒᵖ) →
      (d : (n : ℕ) → ↑(P (n + 1)) →ₗ[Aᵐᵒᵖ] ↑(P n)) →
        [∀ (n : ℕ), Module.Finite Aᵐᵒᵖ ↑(P n)] →
          [∀ (n : ℕ), Module.Projective Aᵐᵒᵖ ↑(P n)] →
            Function.Injective ⇑(StrongNakayama.dualDifferential P d 0) →
              (∀ (n : ℕ),
                  (StrongNakayama.dualDifferential P d n).range = (StrongNakayama.dualDifferential P d (n + 1)).ker) →
                ProjectiveCoresolution (ModuleCat A)
@StrongNakayama.projective_zero : ∀ {A : Type u_1} [inst : Ring A] (P : ℕ → ModuleCat Aᵐᵒᵖ)
  (d : (n : ℕ) → ↑(P (n + 1)) →ₗ[Aᵐᵒᵖ] ↑(P n)) [∀ (n : ℕ), Module.Finite Aᵐᵒᵖ ↑(P n)]
  [∀ (n : ℕ), Module.Projective Aᵐᵒᵖ ↑(P n)], CategoryTheory.Projective (StrongNakayama.cok P d 0)
@StrongNakayama.cok_finite : ∀ {A : Type u_1} [inst : Ring A] (P : ℕ → ModuleCat Aᵐᵒᵖ)
  (d : (n : ℕ) → ↑(P (n + 1)) →ₗ[Aᵐᵒᵖ] ↑(P n)) [∀ (n : ℕ), Module.Finite Aᵐᵒᵖ ↑(P n)]
  [∀ (n : ℕ), Module.Projective Aᵐᵒᵖ ↑(P n)] (n : ℕ), Module.Finite A ↑(StrongNakayama.cok P d n)
@StrongNakayama.not_projective_one : ∀ {A : Type u_1} [inst : Ring A] (P : ℕ → ModuleCat Aᵐᵒᵖ)
  (d : (n : ℕ) → ↑(P (n + 1)) →ₗ[Aᵐᵒᵖ] ↑(P n)) [∀ (n : ℕ), Module.Finite Aᵐᵒᵖ ↑(P n)]
  [∀ (n : ℕ), Module.Projective Aᵐᵒᵖ ↑(P n)],
  Function.Injective ⇑(StrongNakayama.dualDifferential P d 0) →
    (∀ (n : ℕ), (StrongNakayama.dualDifferential P d n).range = (StrongNakayama.dualDifferential P d (n + 1)).ker) →
      ∀ {E : Type u_3} [inst_3 : AddCommGroup E] [inst_4 : Module Aᵐᵒᵖ E] [Nontrivial E] (ε : ↑(P 0) →ₗ[Aᵐᵒᵖ] E),
        Function.Surjective ⇑ε → ε ∘ₗ d 0 = 0 → ¬CategoryTheory.Projective (StrongNakayama.cok P d 1)
@StrongNakayama.projectiveDimension_eq : ∀ {A : Type u_1} [inst : Ring A] (P : ℕ → ModuleCat Aᵐᵒᵖ)
  (d : (n : ℕ) → ↑(P (n + 1)) →ₗ[Aᵐᵒᵖ] ↑(P n)) [∀ (n : ℕ), Module.Finite Aᵐᵒᵖ ↑(P n)]
  [∀ (n : ℕ), Module.Projective Aᵐᵒᵖ ↑(P n)],
  Function.Injective ⇑(StrongNakayama.dualDifferential P d 0) →
    (∀ (n : ℕ), (StrongNakayama.dualDifferential P d n).range = (StrongNakayama.dualDifferential P d (n + 1)).ker) →
      ∀ {E : Type u_3} [inst_3 : AddCommGroup E] [inst_4 : Module Aᵐᵒᵖ E] [Nontrivial E] (ε : ↑(P 0) →ₗ[Aᵐᵒᵖ] E),
        Function.Surjective ⇑ε →
          ε ∘ₗ d 0 = 0 →
            ∀ (n : ℕ),
              1 ≤ n →
                CategoryTheory.HasProjectiveDimensionLE (StrongNakayama.cok P d n) n ∧
                  ¬CategoryTheory.HasProjectiveDimensionLT (StrongNakayama.cok P d n) n
@StrongNakayama.unbounded : ∀ {A : Type u_1} [inst : Ring A] (P : ℕ → ModuleCat Aᵐᵒᵖ)
  (d : (n : ℕ) → ↑(P (n + 1)) →ₗ[Aᵐᵒᵖ] ↑(P n)) [∀ (n : ℕ), Module.Finite Aᵐᵒᵖ ↑(P n)]
  [∀ (n : ℕ), Module.Projective Aᵐᵒᵖ ↑(P n)],
  Function.Injective ⇑(StrongNakayama.dualDifferential P d 0) →
    (∀ (n : ℕ), (StrongNakayama.dualDifferential P d n).range = (StrongNakayama.dualDifferential P d (n + 1)).ker) →
      ∀ {E : Type u_3} [inst_3 : AddCommGroup E] [inst_4 : Module Aᵐᵒᵖ E] [Nontrivial E] (ε : ↑(P 0) →ₗ[Aᵐᵒᵖ] E),
        Function.Surjective ⇑ε →
          ε ∘ₗ d 0 = 0 →
            ∀ (n : ℕ),
              1 ≤ n →
                ∃ M,
                  Module.Finite A ↑M ∧
                    CategoryTheory.HasProjectiveDimensionLE M n ∧ ¬CategoryTheory.HasProjectiveDimensionLT M n
