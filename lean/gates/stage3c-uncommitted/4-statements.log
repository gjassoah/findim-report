  [W.HasRightCalculusOfFractions] {ι : Type u_1} [Finite ι] {X : C} {Y : ι → C} (f g : (i : ι) → X ⟶ Y i),
  (∀ (i : ι), L.map (f i) = L.map (g i)) →
