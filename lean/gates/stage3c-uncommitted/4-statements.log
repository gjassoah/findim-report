  [W.HasRightCalculusOfFractions] [inst_4 : CategoryTheory.Preadditive C] [inst_5 : CategoryTheory.Preadditive D]
  [L.Additive] {ι : Type u_1} [Finite ι] {X : C} {Y : ι → C} (g : (i : ι) → X ⟶ Y i),
