  [W.HasRightCalculusOfFractions] {ι : Type u_1} [Finite ι] {X : C} {Y : ι → C} (γ : (i : ι) → L.obj X ⟶ L.obj (Y i)),
  ∃ X' u,
    ∃ (hu : W u),
      ∃ f,
