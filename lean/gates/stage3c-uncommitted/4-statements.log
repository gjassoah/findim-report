@Stage3cConeSplitting.nonempty_iso_of_hom_exact : ∀ {D : Type u_2} [inst : CategoryTheory.Category.{u_1, u_2} D]
  [inst_1 : CategoryTheory.Preadditive D] {A X B : D} [inst_2 : CategoryTheory.Limits.HasBinaryBiproduct A B]
  (a : A ⟶ X) (b : X ⟶ B),
  CategoryTheory.CategoryStruct.comp a b = 0 →
    (∀ (Z : D) (g : Z ⟶ A), CategoryTheory.CategoryStruct.comp g a = 0 → g = 0) →
      (∀ (Z : D) (g : Z ⟶ X),
          CategoryTheory.CategoryStruct.comp g b = 0 → ∃ h, g = CategoryTheory.CategoryStruct.comp h a) →
        (∀ (Z : D) (g : Z ⟶ B), ∃ h, g = CategoryTheory.CategoryStruct.comp h b) → Nonempty (X ≅ A ⊞ B)
@Stage3cConeSplitting.nonempty_iso_of_complementary_retracts : ∀ {D : Type u_2}
  [inst : CategoryTheory.Category.{u_1, u_2} D] [inst_1 : CategoryTheory.Preadditive D] {X₁ X₂ X₃ X₄ X₅ A B : D}
  [inst_2 : CategoryTheory.Limits.HasBinaryBiproduct B A] (f : X₁ ⟶ X₂) (j : X₂ ⟶ X₃) (v : X₃ ⟶ X₄) (w : X₄ ⟶ X₅),
  CategoryTheory.CategoryStruct.comp j v = 0 →
    (∀ (Z : D) (g : Z ⟶ X₂),
        CategoryTheory.CategoryStruct.comp g j = 0 → ∃ h, g = CategoryTheory.CategoryStruct.comp h f) →
      (∀ (Z : D) (g : Z ⟶ X₃),
          CategoryTheory.CategoryStruct.comp g v = 0 → ∃ h, g = CategoryTheory.CategoryStruct.comp h j) →
        (∀ (Z : D) (g : Z ⟶ X₄),
            CategoryTheory.CategoryStruct.comp g w = 0 → ∃ h, g = CategoryTheory.CategoryStruct.comp h v) →
          ∀ (iB : B ⟶ X₂) (pB : X₂ ⟶ B) (iA : A ⟶ X₄) (pA : X₄ ⟶ A),
            CategoryTheory.CategoryStruct.comp iB pB = CategoryTheory.CategoryStruct.id B →
              CategoryTheory.CategoryStruct.comp f pB = 0 →
                CategoryTheory.CategoryStruct.comp pB (CategoryTheory.CategoryStruct.comp iB j) = j →
                  CategoryTheory.CategoryStruct.comp iA pA = CategoryTheory.CategoryStruct.id A →
                    CategoryTheory.CategoryStruct.comp iA w = 0 →
                      CategoryTheory.CategoryStruct.comp v (CategoryTheory.CategoryStruct.comp pA iA) = v →
                        Nonempty (X₃ ≅ B ⊞ A)
@Stage3cConeSplitting.coneSplittingIso : {C : Type u_2} →
  [inst : CategoryTheory.Category.{u_1, u_2} C] →
    [inst_1 : CategoryTheory.Preadditive C] →
      [inst_2 : CategoryTheory.Limits.HasZeroObject C] →
        [inst_3 : CategoryTheory.HasShift C ℤ] →
          [inst_4 : ∀ (n : ℤ), (CategoryTheory.shiftFunctor C n).Additive] →
            [inst_5 : CategoryTheory.Pretriangulated C] →
              (T : CategoryTheory.Pretriangulated.Triangle C) →
                T ∈ CategoryTheory.Pretriangulated.distinguishedTriangles →
                  {I A B : CategoryTheory.Idempotents.Karoubi C} →
                    (e1 : (CategoryTheory.Idempotents.toKaroubi C).obj T.obj₁ ≅ I ⊞ A) →
                      (e2 : (CategoryTheory.Idempotents.toKaroubi C).obj T.obj₂ ≅ I ⊞ B) →
                        CategoryTheory.CategoryStruct.comp e1.inv
                              (CategoryTheory.CategoryStruct.comp ((CategoryTheory.Idempotents.toKaroubi C).map T.mor₁)
                                e2.hom) =
                            CategoryTheory.CategoryStruct.comp CategoryTheory.Limits.biprod.fst
                              CategoryTheory.Limits.biprod.inl →
                          ((CategoryTheory.Idempotents.toKaroubi C).obj T.obj₃ ≅ B ⊞ (Stage3cKaroubi.shift 1).obj A)
