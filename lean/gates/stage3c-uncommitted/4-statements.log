  [W.HasRightCalculusOfFractions] {ι : Type u_1} (s : Finset ι) {X : C} {Y : ι → C} (f g : (i : ι) → X ⟶ Y i),
  (∀ i ∈ s, L.map (f i) = L.map (g i)) →
