  ∀ T ∈ CategoryTheory.Pretriangulated.distinguishedTriangles,
    ∀ {P : CategoryTheory.Idempotents.Karoubi C}
      (a : P ⟶ (CategoryTheory.Idempotents.toKaroubi C).obj ((CategoryTheory.shiftFunctor C 1).obj T.obj₁)),
