# Sandbox placeholder files (character devices created by the Claude Code sandbox)
/.bash_profile
/.bashrc
/.gitconfig
/.gitmodules
/.idea
/.mcp.json
/.profile
/.ripgreprc
/.vscode
/.zprofile
/.zshrc
# Local Claude Code configuration
/.claude/
# Build outputs
/build/*.aux
/build/*.log
/build/*.out
/build/*.bbl
/build/*.blg
__pycache__/
/lean/.lake/
/.cache/
# Reviewer scratch material: source extracts and page images (third-party copyright), private builds
/scratch/*.txt
/scratch/*.png
/scratch/*.pdf
/scratch/*.patch
/scratch/*-build/
/scratch/*-anchors/
/scratch/*.log
/scratch/*.stdout
/scratch/*/

# SageMath data files (intermediate results; regenerated by the scripts)
*.sobj

# SageMath state and caches, LaTeX/biber logs
**/sage-state*/
**/.sage/
*.blg

# Lean build output of the included formalisation
/lean/formalisation/.lake/
